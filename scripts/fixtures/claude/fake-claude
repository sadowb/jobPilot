#!/usr/bin/env node
import process from 'node:process';
import assert from 'node:assert/strict';
import { createInterface } from 'node:readline';
import { readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { spawn } from 'node:child_process';
if (process.argv.length === 3 && process.argv[2] === '--version') {
  process.stdout.write('2.1.303 (Claude Code fixture)\n');
  process.exit(0);
}
const { Client } = await import('@modelcontextprotocol/sdk/client/index.js');
const { StdioClientTransport } = await import('@modelcontextprotocol/sdk/client/stdio.js');

// Deterministic CLI protocol fixture: real SDK transport + stdio MCP, no model or credentials.
assert.equal(process.env.POISON, undefined);
assert.equal(process.env.CLAUDE_CODE_OAUTH_TOKEN, undefined);
if (process.env.ANTHROPIC_API_KEY) {
  assert.equal(process.env.ANTHROPIC_API_KEY, 'fixture-key');
  assert(process.env.CLAUDE_CONFIG_DIR);
} else assert.equal(process.env.CLAUDE_CONFIG_DIR, undefined);
assert.equal(process.env.CLAUDE_CODE_DISABLE_AUTO_MEMORY, '1');
const send = (value) => process.stdout.write(JSON.stringify(value) + '\n');
const argument = (flag) => {
  const inline = process.argv.find((value) => value.startsWith(flag + '='));
  return inline ? inline.slice(flag.length + 1) : process.argv[process.argv.indexOf(flag) + 1];
};
process.on('uncaughtException', (error) => {
  send({ type: 'assistant', message: { content: [{ type: 'text', text: 'Fixture failure: ' + error.message }] } });
  process.exit(1);
});
for await (const line of createInterface({ input: process.stdin })) {
  const request = JSON.parse(line);
  if (request.type === 'control_request') {
    send({ type: 'control_response', response: { subtype: 'success', request_id: request.request_id, response: {} } });
  } else if (request.type === 'user') {
    send({ type: 'system', subtype: 'init', session_id: 'fixture-session' });
    const prompt = JSON.stringify(request.message);
    assert(['fixture-model', 'haiku', 'sonnet', 'opus'].includes(argument('--model')));
    assert(argument('--json-schema'));
    assert(process.argv.includes('--strict-mcp-config'));
    assert(process.argv.includes('--no-session-persistence'));
    assert.equal(argument('--setting-sources'), '');
    assert.equal(argument('--tools'), '');
    assert(!process.argv.includes('--plugin-dir'));
    const config = JSON.parse(argument('--mcp-config'));
    assert.deepEqual(Object.keys(config.mcpServers), ['form']);
    if (prompt.includes('isolation')) {
      const settings = JSON.parse(readFileSync(join(process.env.HOME, '.claude/settings.json'), 'utf8'));
      assert(settings.hooks.SessionStart);
      assert(settings.mcpServers.personal);
      assert(!JSON.stringify(config).includes('personal'));
    }
    if (prompt.includes('wait')) {
      writeFileSync(join(process.cwd(), 'child.pid'), String(process.pid));
      const descendant = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore' });
      writeFileSync(join(process.cwd(), 'descendant.pid'), String(descendant.pid));
    }
    send({ type: 'assistant', message: { content: [{ type: 'text', text: 'model:' + argument('--model') }] } });
    if (prompt.includes('not-logged-in')) {
      send({ type: 'assistant', error: 'authentication_failed', message: { content: [] } });
      process.exit(1);
    }
    if (prompt.includes('Fill again')) assert.equal(argument('--resume'), 'fixture-session');
    if (prompt.includes('wait')) continue;
    if (prompt.includes('crash')) {
      process.stderr.write('token=fixture-token ' + 'x'.repeat(175) + 'fixture-key' + 'x'.repeat(250) + 'beyond-limit');
      process.exit(23);
    }
    const server = config.mcpServers.form;
    const client = new Client({ name: 'fixture', version: '1.0.0' });
    try {
      await client.connect(new StdioClientTransport({ command: server.command, args: server.args, env: server.env }));
      send({
        type: 'assistant',
        message: {
          content: [
            { type: 'text', text: 'fixture-key' },
            { type: 'tool_use', id: 'fill-1', name: 'mcp__form__fill', input: { name: 'Example' } },
          ],
        },
      });
      const filled = await client.callTool({ name: 'fill', arguments: { name: 'Example' } });
      assert.match(JSON.stringify(filled), /value=\\?"Example/);
      send({
        type: 'user',
        message: { content: [{ type: 'tool_result', tool_use_id: 'fill-1', content: filled.content }] },
      });
      send({
        type: 'result',
        subtype: 'success',
        is_error: false,
        modelUsage: {},
        total_cost_usd: 0,
        structured_output: prompt.includes('invalid')
          ? { status: 'bogus' }
          : {
              status: 'filled',
              answers_used: [],
              answers_added: [],
              questions_needed: [],
              learned: [],
              blockers: [],
              form_hash: 'fixture-form',
            },
      });
    } finally {
      await client.close();
    }
    process.exit(0);
  }
}
