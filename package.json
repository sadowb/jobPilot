{
  "name": "jobpilot",
  "version": "0.1.0",
  "description": "JobPilot desktop app",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Abdelhadi Marjane",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "npm run build && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node --input-type=module -e \"import { execa } from 'execa'; await Promise.all(['node', 'web', 'test'].map(project => execa('tsc', ['--noEmit', '-p', 'tsconfig.' + project + '.json'], { stdio: 'inherit' })));\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && gitleaks git --redact && npm audit --audit-level=high && npm run db:check && npm run build && npm run smoke:native && electron-builder --dir && node scripts/run-e2e.mjs && node scripts/verify-shipped.mjs",
    "tokens": "node scripts/gen-tokens.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:diff": "node scripts/visual/diff.mjs",
    "postinstall": "electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate && node scripts/db-strict.mjs",
    "db:check": "drizzle-kit check && node scripts/db-strict.mjs --check",
    "smoke:native": "ELECTRON_RUN_AS_NODE=1 electron scripts/smoke-native.mjs",
    "postings:probe": "node scripts/probe-postings.mjs",
    "agents:probe": "tsx scripts/probe-claude.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.309",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/bagel-fat-one": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "execa": "10.2.0",
    "libphonenumber-js": "1.13.15",
    "linkedom": "^0.18.14",
    "liteque": "0.10.0",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "ulid": "3.0.2",
    "undici": "^8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
