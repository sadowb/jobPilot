{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // linkedom's parseHTML is typed as a DOM Window (pino-roll's date-fns types used to pull this lib in implicitly).
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "exclude": ["tests/**/*.tsx"]
}
